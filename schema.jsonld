      "mainEntity": [
        {
          "@type": "Question",
          "name": "Should I have pages for each Inland Empire city I serve?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not for all of them. A city gets its own page when you have something different to say there, like a location, a team or a service offered only there. Otherwise one strong page with a clear service area works better."
